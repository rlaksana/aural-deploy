# ──────────────────────────────────────
# Supabase
# ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ──────────────────────────────────────
# App URL
# ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────
# LLM Providers
# ──────────────────────────────────────
# All text LLM features route through the shared LiteLLM gateway:
# AI_API_KEY + AI_BASE_URL are REQUIRED for generation, parsing, summaries and
# analysis; AI_MODEL selects the gateway model (default minimax-m3.1).
AI_BASE_URL=https://api-eng.andalsoftware.com
AI_MODEL=minimax-m3.1
AI_API_KEY=

# Cron secret for /api/cron/ai-jobs (the deferred batch-AI queue runner).
# The GitHub Actions ai-jobs-cron workflow sends it as
# "Authorization: Bearer <CRON_SECRET>"; the same value must be set on the
# deployment that executes the queue (the VPS compose stack).
CRON_SECRET=

# Operating window for heavy batch AI work (17:00–07:00 WIB). Test-only
# override — never set in production.
# AI_WINDOW_OVERRIDE=open

# OpenRouter (REQUIRED: powers the structured-output repair model and the
# transport fallback when the gateway is unreachable)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Google Gemini
GEMINI_API_KEY=

# Moonshot Kimi
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# MiniMax — voice-only (ASR + TTS for the voice relay); text LLMs use the
# LiteLLM gateway above.
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# Z.AI (GLM) — currently unused; kept for reference.
# ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Optional: raises the rate limit for the browser-backed fallback used when a
# public JD page blocks normal server-side fetching (for example, HTTP 403).
JINA_READER_API_KEY=

# ──────────────────────────────────────
# Email (Resend) — position interview invites
# ──────────────────────────────────────
# Optional: when both are set, candidate invites are emailed via Resend
# (RESEND_FROM must be an address on a domain verified in the Resend
# dashboard). When unset, the invite flow still works — the UI shows a
# copyable invite link and the server logs it instead of sending.
# RESEND_API_KEY=
# RESEND_FROM="Aural Invites <invites@yourdomain.com>"

# ──────────────────────────────────────
# Voice Relay
# ──────────────────────────────────────
VOICE_RELAY_PORT=8766
# Shared HMAC secret between web app and voice relay. When set, the relay
# only accepts connections carrying a ticket from /api/voice/relay-ticket.
# Required for any deployment reachable from the internet.
# VOICE_RELAY_SECRET=

# Browser-facing relay URL. In production behind a reverse proxy, this can
# point to a same-origin WebSocket path such as /ws/voice.
NEXT_PUBLIC_VOICE_RELAY_URL=ws://localhost:8766

# ──────────────────────────────────────
# Relay LLM
# ──────────────────────────────────────
# Used by the voice relay for interviewer replies and context summarization.
# Defaults to MiniMax-M3.
RELAY_LLM_PROVIDER=openai
RELAY_LLM_MODEL=MiniMax-M3
RELAY_LLM_TEMPERATURE=0
# Optional; falls back to MINIMAX_API_KEY.
# RELAY_LLM_API_KEY=
# Only needed for OpenAI-compatible relay LLMs.
# RELAY_LLM_BASE_URL=
# RELAY_LLM_FALLBACK_MODEL=MiniMax-M3
# RELAY_LLM_FALLBACK_BASE_URL=https://api.minimax.io/v1

# ──────────────────────────────────────
# MiniMax Voice Services (ASR + TTS)
# ──────────────────────────────────────
# The voice relay reuses MINIMAX_API_KEY (same key as the LLM). The base URL
# must be the international endpoint: https://api.minimax.io/v1.
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_TTS_MODEL=speech-2.8-turbo
# MINIMAX_TTS_VOICE_EN=English_Trustworth_Man
# MINIMAX_TTS_VOICE_ZH=male-qn-qingse
# MINIMAX_TTS_SPEECH_RATE=1

# Optional ASR endpointing overrides. The defaults are tuned for natural
# interview pauses and should work well for most deployments.
# MINIMAX_ASR_END_WINDOW_MS=800
# MINIMAX_ASR_MIN_SPEECH_MS=300
# MINIMAX_ASR_FINAL_COALESCE_MS=1500
# MINIMAX_ASR_LONG_FINAL_COALESCE_MS=3000
# MINIMAX_ASR_SHORT_FINAL_COALESCE_MS=300
# MINIMAX_ASR_ACTIVE_SPEECH_HOLD_MS=600
# MINIMAX_ASR_PENDING_FINAL_QUIET_MS=1600
# MINIMAX_ASR_MAX_ACTIVE_SPEECH_HOLD_MS=60000

# ──────────────────────────────────────
# Optional
# ──────────────────────────────────────
# LOG_LEVEL=info
